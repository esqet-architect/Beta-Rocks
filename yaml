name: Build FossilScanner APK

on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.19.x' # or your target version
          channel: 'stable'
          cache: true

      # Option A: Tell all run steps where the app lives
      - name: Install Dependencies & Build APK
        run: |
          flutter pub get
          flutter build apk --release
        working-directory: flutter_frontend
